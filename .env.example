# --- SUPABASE CONFIGURATION (Frontend & Backend) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- SUPABASE BACKEND SECURITY (FastAPI Only) ---
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
WEBHOOK_SECRET=your-shared-webhook-secret-token

# --- SUPABASE TRIGGERS CONFIGURATION (Python Setup Only) ---
# Webhook destination URL for Supabase storage triggers (must be publicly accessible via ngrok or similar)
WEBHOOK_TARGET_URL=https://your-ngrok-tunnel-url/api/v1/webhooks/storage

# --- REDIS CACHE CONFIGURATION ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- DATABASE CONFIGURATION (FastAPI & Alembic) ---
# Replace with your actual Supabase database connection string
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
